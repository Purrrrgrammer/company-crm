<Window x:Class="CompanyCRM.MVVM.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Height="350" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Дата" FontWeight="Bold" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="1" SelectedDate="{Binding Date}" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" Text="Сумма" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" Text="{Binding Amount}" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="4" Text="Сотрудник" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" 
                  ItemsSource="{Binding Employees}"
                  DisplayMemberPath="FullName"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding EmployeeId}"
                  Margin="0,25,0,15"/>

        <TextBlock Grid.Row="5" Text="Контрагент" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" 
                  ItemsSource="{Binding Contractors}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding ContractorId}"
                  Margin="0,25,0,15"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>