<Window x:Class="CompanyCRM.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company CRM" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Command="{Binding AddCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="100"/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedItem="{Binding SelectedTab}">
            <TabItem Header="Сотрудники" Tag="Employees">
                <Grid Margin="5">
                    <DataGrid ItemsSource="{Binding Employees}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectedItem="{Binding SelectedEmployee}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="150"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Контрагенты" Tag="Contractors">
                <Grid Margin="5">
                    <DataGrid ItemsSource="{Binding Contractors}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectedItem="{Binding SelectedContractor}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="ИНН" Binding="{Binding Inn}" Width="150"/>
                            <DataGridTextColumn Header="Куратор" Binding="{Binding CuratorName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Заказы" Tag="Orders">
                <Grid Margin="5">
                    <DataGrid ItemsSource="{Binding Orders}" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectedItem="{Binding SelectedOrder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="120"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="150"/>
                            <DataGridTextColumn Header="Контрагент" Binding="{Binding ContractorName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>